generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  openid         String    @unique
  phoneNumber    String?   @unique
  name           String?
  avatar         String?
  identityType   String?
  gender         Int       @default(0)
  householdNo    String?
  birth          String?
  address        Json?
  photos         Json?
  brief          String?
  enabled        Boolean   @default(true)
  disabledAt     DateTime?
  disabledReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([enabled, createdAt])
  @@map("users")
}

model AvatarReview {
  id            String    @id @default(cuid())
  userId        String
  mediaUrl      String    @db.Text
  traceId       String?   @unique
  status        String    @db.VarChar(24)
  suggest       String?   @db.VarChar(24)
  label         Int?
  wechatErrcode Int?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@map("avatar_reviews")
}

/// 上传到 COS 的业务媒体资产；业务记录只保留 URL，生命周期统一由本表管理。
model MediaAsset {
  id                  String          @id @default(cuid())
  objectKey           String          @unique @db.VarChar(512)
  url                 String          @db.Text
  uploaderId          String          @db.VarChar(191)
  module              String          @db.VarChar(32)
  mediaType           MediaAssetType
  /// 原始文件元数据仅用于附件下载展示；旧图片/视频记录允许为空。
  originalName        String?         @db.VarChar(255)
  contentType         String?         @db.VarChar(191)
  sizeBytes           Int?
  forumAttachmentBlobId String?
  state               MediaAssetState @default(PENDING)
  attachedAt          DateTime?
  deleteRequestedAt   DateTime?
  deletedAt           DateTime?
  deleteAttempts      Int             @default(0)
  lastDeleteError     String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  forumPostAttachment ForumPostAttachment?
  forumAttachmentBlob  ForumAttachmentBlob? @relation(fields: [forumAttachmentBlobId], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([state, deleteRequestedAt])
  @@index([forumAttachmentBlobId])
  @@map("media_assets")
}

/// 论坛附件的不可变物理文件；同一 SHA-256 在系统中只保存一个 COS 对象。
model ForumAttachmentBlob {
  id                String   @id @default(cuid())
  sha256            String   @unique @db.Char(64)
  objectKey         String   @unique @db.VarChar(512)
  url               String   @db.Text
  contentType       String   @db.VarChar(191)
  sizeBytes         Int
  deleteRequestedAt DateTime?
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mediaAssets MediaAsset[]

  @@index([deleteRequestedAt])
  @@map("forum_attachment_blobs")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("feedbacks")
}

/// 用户站内通知；业务写入必须与对应状态变化共用同一事务
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  actorId     String?
  type        String    @db.VarChar(48)
  bizType     String    @db.VarChar(32)
  bizId       String?   @db.VarChar(191)
  title       String    @db.VarChar(191)
  content     String    @db.Text
  dedupeKey   String    @db.VarChar(255)
  readAt      DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, deletedAt, createdAt])
  @@index([recipientId, readAt, deletedAt])
  @@index([bizType, bizId])
  @@map("notifications")
}

/// 超级管理员系统通知发布意图；用于跨请求幂等，不保存通知正文
model SystemNoticePublication {
  id             String   @id @db.VarChar(64)
  adminId        String   @db.VarChar(191)
  payloadHash    String   @db.Char(64)
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([adminId, createdAt])
  @@map("system_notice_publications")
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  type         AdminType @default(OFFICIAL)
  orgName      String?
  /// 绑定的小程序 User.id；普通管理员仅能增删改以该身份发布的内容
  boundUserId  String?
  enabled      Boolean   @default(true)
  sessionVersion Int     @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([role, enabled])
  /// 一个小程序用户最多绑定一个后台管理员；标签展示以该实时绑定关系为准。
  @@unique([boundUserId])
  @@map("admin_users")
}

/// 后台系统日志（仅超级管理员可查看）
model AdminSystemLog {
  id            String   @id @default(cuid())
  adminId       String
  adminUsername String
  ip            String
  action        String
  moduleKey     String?
  detail        Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([adminId, moduleKey, createdAt])
  @@map("admin_system_logs")
}

/// 当前环境的数据库自动备份设置（单例记录）
model DatabaseBackupSetting {
  id              String          @id @default("default") @db.VarChar(32)
  enabled         Boolean         @default(true)
  frequency       BackupFrequency @default(HOURLY)
  minute          Int             @default(5)
  dailyHour       Int             @default(2)
  lastScheduledAt DateTime?
  updatedBy       String?         @db.VarChar(191)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@map("database_backup_settings")
}

/// 数据库备份执行记录；任务与最终备份文件分离，便于审计成功、失败与跳过状态
model DatabaseBackupJob {
  id                 String          @id @default(cuid())
  triggerType        BackupTrigger
  status             BackupJobStatus @default(PENDING)
  /// 同一环境只允许一个 PENDING/RUNNING 任务；完成后清空
  activeKey          String?         @unique @db.VarChar(32)
  scheduleKey        String?         @unique @db.VarChar(64)
  environment        String          @db.VarChar(32)
  requestedByAdminId String?         @db.VarChar(191)
  outputFileName     String?         @db.VarChar(255)
  outputSizeBytes    BigInt?
  errorMessage       String?         @db.Text
  scheduledAt        DateTime        @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  durationMs         Int?
  createdAt          DateTime        @default(now())

  @@index([status, createdAt])
  @@index([triggerType, createdAt])
  @@index([createdAt])
  @@map("database_backup_jobs")
}

/// 数据库级备份执行租约；跨进程、跨实例保证同一环境只有一个执行器
model DatabaseBackupLease {
  environment String   @id @db.VarChar(32)
  ownerToken  String   @db.VarChar(64)
  expiresAt   DateTime
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([expiresAt])
  @@map("database_backup_leases")
}

/// 小程序接口错误日志（后台可查看，用于定位 C 端接口报错）
model MiniProgramApiErrorLog {
  id           String   @id @default(cuid())
  userId       String?
  openid       String?
  ip           String?
  method       String   @db.VarChar(16)
  path         String   @db.VarChar(512)
  url          String?  @db.Text
  statusCode   Int?
  errorMessage String   @db.Text
  requestData  Json?
  responseData Json?
  stack        String?  @db.Text
  platform     String?
  appVersion   String?
  sdkVersion   String?
  system       String?
  networkType  String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([method, createdAt])
  @@index([statusCode, createdAt])
  @@map("mini_program_api_error_logs")
}

/// API 路由注册表；method 由注册服务规范化为大写，routePattern 按大小写区分
model ApiEndpoint {
  id           String   @id @default(cuid()) @db.VarChar(191)
  source       String   @db.VarChar(24)
  method       String   @db.VarChar(16)
  routePattern String   @db.VarChar(512)
  description  String?  @db.VarChar(500)
  logEnabled   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([method, routePattern])
  @@index([source, logEnabled])
  @@index([updatedAt])
  @@map("api_endpoints")
}

/// 统一接口请求日志；错误字段仅在 4xx/5xx 时保存脱敏诊断信息。
model ApiRequestLog {
  id              BigInt   @id @default(autoincrement())
  requestId       String   @db.VarChar(64)
  endpointId      String?  @db.VarChar(191)
  source          String   @db.VarChar(24)
  method          String   @db.VarChar(16)
  routePattern    String   @db.VarChar(512)
  requestUrl      String?  @db.Text
  ip              String?  @db.VarChar(64)
  userId          String?  @db.VarChar(191)
  adminId         String?  @db.VarChar(191)
  httpStatus      Int
  businessCode    Int?
  durationMs      Int
  errorCode       String?  @db.VarChar(96)
  errorSummary    String?  @db.Text
  requestSnapshot Json?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([requestId])
  @@index([ip, createdAt])
  @@index([endpointId, createdAt])
  @@index([method, createdAt])
  @@index([source, createdAt])
  @@index([httpStatus, createdAt])
  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([durationMs, createdAt])
  @@map("api_request_logs")
}

model Task {
  id                String            @id @default(cuid())
  title             String
  desc              String            @db.Text
  images            Json?
  videos            Json?
  reward            String?
  location          Json?
  status            TaskStatus        @default(PENDING_TAKE)
  version           Int               @default(0)
  visibility        ContentVisibility @default(ONLINE)
  pinned            Boolean           @default(false)
  publisherId       String
  publisherName     String?
  publisherAvatar   String?
  /// 标记内容由哪个后台管理员创建（用于审计/展示）
  createdByAdminId  String?
  takerId           String?
  takerName         String?
  takerAvatar       String?
  proofText         String?           @db.Text
  proofImages       Json?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  claimedAt         DateTime?
  completedAt       DateTime?
  confirmedAt       DateTime?

  @@index([status, createdAt])
  @@index([visibility, pinned, createdAt])
  @@index([publisherId, createdAt])
  @@index([takerId, claimedAt])
  @@index([deletedAt])
  @@index([createdByAdminId])
  @@map("tasks")
}

/// 小区留言（论坛帖子），对应小程序 forumAPI / api/posts
model ForumPost {
  id               String            @id @default(cuid())
  title            String
  content          String            @db.Text
  images           Json?
  videos           Json?
  authorId         String
  authorName       String?
  authorAvatar     String?
  /// 标记内容由哪个后台管理员创建（用于审计/展示）
  createdByAdminId String?
  postType         ForumPostType     @default(NORMAL)
  featureType      ForumPostFeatureType @default(CONTENT)
  validUntil       DateTime?
  visibility       ContentVisibility @default(ONLINE)
  pinned           Boolean           @default(false)
  viewCount        Int               @default(0)
  likeCount        Int               @default(0)
  replyCount       Int               @default(0)
  shareCount       Int               @default(0)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())

  replies   ForumReply[]
  likes     ForumPostLike[]
  favorites ForumPostFavorite[]
  registration ForumPostRegistration?
  attachments ForumPostAttachment[]

  @@index([pinned, createdAt])
  @@index([visibility, pinned, createdAt])
  @@index([postType, visibility, validUntil, createdAt])
  @@index([featureType, visibility, createdAt])
  @@index([authorId, createdAt])
  @@index([deletedAt])
  @@index([createdByAdminId])
  @@map("forum_posts")
}

/// 帖子附件的顺序关联；每个文件资产最多归属一篇帖子。
model ForumPostAttachment {
  id           String     @id @default(cuid())
  postId       String
  mediaAssetId String     @unique
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  post       ForumPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("forum_post_attachments")
}

/// 报名功能贴的配置；仅 featureType 为 REGISTRATION 的帖子拥有该记录。
model ForumPostRegistration {
  postId     String   @id
  capacity   Int
  deadlineAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  post    ForumPost                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  entries ForumPostRegistrationEntry[]

  @@index([deadlineAt])
  @@map("forum_post_registrations")
}

/// 报名功能贴的用户报名记录；同一用户对同一帖子只能保留一条。
model ForumPostRegistrationEntry {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  registration ForumPostRegistration @relation(fields: [postId], references: [postId], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, createdAt])
  @@map("forum_post_registration_entries")
}

model ForumReply {
  id                String   @id @default(cuid())
  postId            String
  parentReplyId     String?
  /// 被回复人昵称快照（楼中楼展示「回复 @xxx」）
  replyToAuthorName String?
  replyToUserId     String?
  authorId          String
  authorName        String?
  authorAvatar      String?
  content           String   @db.Text
  images            Json?
  videos            Json?
  likeCount         Int      @default(0)
  favoriteCount     Int      @default(0)
  createdAt         DateTime @default(now())

  post      ForumPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    ForumReply?          @relation("ForumReplyThread", fields: [parentReplyId], references: [id], onDelete: Cascade)
  children  ForumReply[]         @relation("ForumReplyThread")
  likes     ForumReplyLike[]
  favorites ForumReplyFavorite[]
  reactions ForumReplyReaction[]

  @@index([postId, createdAt])
  @@index([parentReplyId, createdAt])
  @@index([authorId])
  @@index([replyToUserId])
  @@map("forum_replies")
}

model ForumReplyLike {
  id        String   @id @default(cuid())
  replyId   String
  userId    String
  createdAt DateTime @default(now())

  reply ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([userId, createdAt])
  @@map("forum_reply_likes")
}

model ForumReplyFavorite {
  id        String   @id @default(cuid())
  replyId   String
  userId    String
  createdAt DateTime @default(now())

  reply ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([userId, createdAt])
  @@map("forum_reply_favorites")
}

/// 每条评论每用户最多一个表情（可更换）
model ForumReplyReaction {
  id        String   @id @default(cuid())
  replyId   String
  userId    String
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())

  reply ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([replyId, emoji])
  @@map("forum_reply_reactions")
}

model ForumPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("forum_post_likes")
}

model ForumPostFavorite {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("forum_post_favorites")
}

model AppSettingTab {
  id        String   @id @default(cuid())
  key       String   @unique
  icon      String   @default("")
  enabled   Boolean  @default(true)
  always    Boolean  @default(false)
  labelEnc  String?
  label     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([order])
  @@map("app_setting_tabs")
}

/// 小区市场商品，对应小程序 mallAPI / api/items
model MallCategory {
  id        String   @id @db.VarChar(64)
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([enabled, sortOrder])
  @@index([sortOrder])
  @@map("mall_categories")
}

model MallItem {
  id               String            @id @default(cuid())
  categoryId       String
  title            String
  price            String?
  unit             String            @default("元")
  desc             String            @db.Text
  wechatContact    String?           @db.VarChar(100)
  phoneContact     String?           @db.VarChar(32)
  phoneIsWechat    Boolean           @default(false)
  /// 历史自由文本联系方式，仅用于兼容旧商品
  contact          String?
  locationName     String?
  locationAddress  String?           @db.Text
  latitude         Float?
  longitude        Float?
  /// 主图（用于列表封面 + 详情轮播），最多 6 张（后端校验）
  mainImages       Json?
  /// 副图（用于详情轮播），与主图合计最多 6 张（后端校验）
  subImages        Json?
  /// 视频列表（用于详情展示），数量/大小由上传层控制
  videos           Json?
  /// 兼容旧字段（历史数据可能仍写入该字段）
  images           Json?
  publisherId      String
  publisherName    String?
  publisherAvatar  String?
  /// 标记内容由哪个后台管理员创建（用于审计/展示）
  createdByAdminId String?
  visibility       ContentVisibility @default(ONLINE)
  pinned           Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  favorites MallItemFavorite[]
  orders    MallOrder[]
  comments  MallItemComment[]

  @@index([categoryId, createdAt])
  @@index([visibility, pinned, createdAt])
  @@index([publisherId, createdAt])
  @@index([deletedAt])
  @@index([createdByAdminId])
  @@map("mall_items")
}

/// 小区市场商品评论
model MallItemComment {
  id                String   @id @default(cuid())
  itemId            String
  userId            String
  /// 楼中楼：仅允许回复「主评论」（parentId 为空的那条）
  parentId          String?
  /// 被回复人昵称快照（展示「回复 @xxx」）
  replyToAuthorName String?
  replyToUserId     String?
  authorName        String?
  authorAvatar      String?
  content           String   @db.Text
  images            Json?
  createdAt         DateTime @default(now())

  item     MallItem              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  parent   MallItemComment?      @relation("MallItemCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  children MallItemComment[]     @relation("MallItemCommentThread")
  likes    MallItemCommentLike[]

  @@index([itemId, parentId, createdAt])
  @@index([itemId, createdAt])
  @@index([userId, createdAt])
  @@index([replyToUserId])
  @@map("mall_item_comments")
}

model MallItemCommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment MallItemComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId, createdAt])
  @@map("mall_item_comment_likes")
}

model MallItemFavorite {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  createdAt DateTime @default(now())

  item MallItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId, createdAt])
  @@map("mall_item_favorites")
}

/// pending | completed | cancelled（与小程序订单状态一致）
model MallOrder {
  id              String   @id @default(cuid())
  itemId          String
  itemTitle       String
  itemPrice       String?
  itemUnit        String   @default("元")
  sellerId        String
  sellerName      String?
  sellerAvatar    String?
  buyerId         String
  buyerName       String?
  buyerAvatar     String?
  contact         String?
  clientRequestId String   @db.VarChar(64)
  status          String   @default("pending")
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  item MallItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([buyerId, clientRequestId])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@map("mall_orders")
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum MediaAssetState {
  PENDING
  ATTACHED
  DELETING
  DELETE_PENDING
  DELETED
  DELETE_FAILED
}

enum MediaAssetType {
  IMG
  VID
  FILE
}

enum AdminType {
  OFFICIAL
  THIRD_PARTY
}

enum BackupFrequency {
  HOURLY
  EVERY_6_HOURS
  DAILY
}

enum BackupTrigger {
  AUTO
  MANUAL
}

enum BackupJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum ContentVisibility {
  ONLINE
  OFFLINE
}

enum ForumPostType {
  NORMAL
  ANNOUNCEMENT
}

enum ForumPostFeatureType {
  CONTENT
  REGISTRATION
}

enum TaskStatus {
  DRAFT
  PENDING_TAKE
  IN_PROGRESS
  PENDING_CONFIRM
  COMPLETED
  CANCELLED
}
